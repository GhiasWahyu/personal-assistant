# ==============================================================================
# .env.example — Salin file ini menjadi .env dan isi dengan nilai asli Anda.
# File .env TIDAK boleh di-commit ke Git (sudah masuk .gitignore).
# ==============================================================================

# === TELEGRAM BOT ===
# Dapatkan dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=

# Chat ID tujuan untuk morning briefing (dapatkan dari @userinfobot)
TELEGRAM_CHAT_ID=

# === DATABASE (SUPABASE / POSTGRESQL) ===
# Format: postgresql://user:password@host:port/database
# Jika password mengandung karakter '@', tidak perlu encode manual —
# sanitize_db_url() akan menanganinya secara otomatis.
DATABASE_URL=

# === GEMINI AI (GOOGLE AI STUDIO) ===
# Dapatkan dari https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Model Gemini yang digunakan (opsional, default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# === DEPLOYMENT (hanya untuk install_all.sh di GCP/VPS) ===
# Password untuk user postgres lokal di server
POSTGRES_PASSWORD=
